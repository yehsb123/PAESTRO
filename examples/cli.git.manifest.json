{
  "plugin": {
    "id": "cli.git",
    "displayName": "Git CLI",
    "version": "2.x",
    "runtime": "cli",
    "auth": { "type": "none" },
    "sandbox": "none"
  },
  "capabilities": [
    {
      "id": "cli.git.log_graph",
      "intent": "커밋 로그를 그래프로 본다",
      "keywords": ["로그", "log", "그래프", "graph", "git", "히스토리"],
      "when_to_use": "브랜치 히스토리를 시각적으로 확인할 때",
      "when_not_to_use": "특정 파일 변경 이력은 git.log_file",
      "invocation": { "type": "cli", "argv_template": ["git", "log", "--oneline", "--graph", "-n", "{n}"] },
      "side_effects": "read_only",
      "cost_hint": "local instant",
      "examples": [{ "q": "git 로그 그래프로 보여줘" }]
    }
  ]
}
